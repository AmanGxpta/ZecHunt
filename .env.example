# Copy to .env.local. Never commit real values. Never paste secrets into agent chats.

# HMAC key for tokens, checkpoint codes and hashes. REQUIRED in production.
#   openssl rand -base64 32
ZECHUNT_SECRET=change-me-locally
ZECHUNT_DB_PATH=.data/zechunt.db

# Per-provider mode: mock (default) | live. The UI labels every mock result as simulated.
ZECHUNT_ZCASH_MODE=mock
ZECHUNT_BITREFILL_MODE=mock

# --- Zcash (live): zkool2 GraphQL server holding a WATCH-ONLY (UFVK) account ---
ZECHUNT_ZKOOL_GRAPHQL_URL=http://127.0.0.1:8000/graphql
ZECHUNT_ZKOOL_ACCOUNT_ID=
ZECHUNT_ZKOOL_BEARER_TOKEN=
ZECHUNT_ZCASH_MAPPING_DB=.data/zcash-addresses.db

# --- Bitrefill ---
# Total event credit the app may ever commit, in USD. The spend guard enforces it.
BITREFILL_CREDIT_USD=25
ZECHUNT_REWARD_COUNTRY=IN

ZECHUNT_WORKER_INTERVAL_MS=15000

# --- Bitrefill (live) — see docs/BITREFILL_INTEGRATION.md ---
BITREFILL_API_KEY=
ZECHUNT_BITREFILL_DB=.data/bitrefill.db
# Dry run unless exactly "true". Even then, each purchase needs a human approval:
#   ZECHUNT_BITREFILL_DB=... npx tsx scripts/bitrefill-approve.ts swiggy-money-india:50 55
ZECHUNT_LIVE_PURCHASES=false
BITREFILL_ACCOUNT_PRICES_ARE_USD=false
BITREFILL_PER_PURCHASE_CAP_CENTS=55
BITREFILL_DAILY_CAP_CENTS=55
BITREFILL_TOTAL_CAP_CENTS=55
